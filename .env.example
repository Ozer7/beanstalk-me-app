# Copy to .env (which git ignores) and fill in. On Render, set these in the Environment tab instead.
OPENAI_API_KEY=
DATABASE_URL=            # Postgres, e.g. Neon's connection string (with sslmode=require)
GOOGLE_CLIENT_ID=        # Google Cloud → Google Auth Platform → Clients
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=          # any long random string
ACCESS_PASSWORD=         # the "magic word" asked before sign-in (not case-sensitive); unset = no password screen

# Optional
# IMAGE_MODEL=gpt-image-2.5-flare      # default gpt-image-2.5-sunburst
# IMAGE_QUALITY=low                    # pages: low | medium | high (default high). low = cheap testing
# REFERENCE_QUALITY=low                # Jack and his sheet (default high)
# IMAGE_CONCURRENCY=3                  # pictures drawn at the same time on the server
# DAILY_IMAGE_LIMIT=60                 # image calls per account per 24 hours
# LOG_LEVEL=info

# Local testing only (ignored on Render)
# MOCK_IMAGES=1                        # placeholder pictures, no API calls, no cost
# MOCK_DELAY_MS=5000                   # how long a placeholder takes (to watch the progress bars)
# DEV_LOGIN=1                          # adds /auth/dev: sign in as a test user without Google
# PGSSL=0                              # local Postgres without TLS
